# Kopiere diese Datei zu .env.local und trage echte Werte ein.
# .env.local wird nie committed (siehe .gitignore: *.local).

# Von Vercel/Neon nach dem Anlegen der Postgres-Datenbank bereitgestellt,
# oder per `vercel env pull .env.local` direkt abgeholt.
DATABASE_URL=

# Frei wählbares Passwort für den Login-Bildschirm der App.
SITE_PASSWORD=

# Zufälliger, langer, geheimer String zum Signieren des Login-Cookies.
# Erzeugen z.B. mit: openssl rand -hex 32
SESSION_SECRET=
